# Classic histogram aggregation: preserve le; optionally preserve pod/model_id.
histogram_quantile(0.95, sum by(le) (rate(hw11_ttfc_seconds_bucket[30s])))
histogram_quantile(0.95, sum by(le,pod) (rate(hw11_duration_seconds_bucket[30s])))
sum by(pod) (hw11_running)
sum by(pod) (hw11_waiting)
sum by(pod,outcome) (rate(hw11_requests_total[30s]))
sum(rate(hw11_requests_total{outcome="rejected"}[30s])) / sum(rate(hw11_requests_total[30s]))
sum by(pod) (rate(container_cpu_usage_seconds_total{namespace="hw11",container="api"}[30s]))
sum by(pod) (container_memory_working_set_bytes{namespace="hw11",container="api"})
sum(kube_pod_status_ready{namespace="hw11",condition="true",pod=~"hw11-api-.*"})
# Exact completed cohort: each phase occurs once, starts at zero, no Pod restart in B.
# Snapshot after all clients finish and next scrape; client includes only done=True.
histogram_quantile(0.95, sum by(le) (hw11_ttfc_seconds_bucket{phase="b_none_uniform_1"}))
sum(hw11_ttfc_seconds_count{phase="b_none_uniform_1"})
# A time window alternative requires aligned boundaries and sufficiently dense scrapes:
histogram_quantile(0.95, sum by(le) (increase(hw11_ttfc_seconds_bucket{phase="b_none_uniform_1"}[125s])))
