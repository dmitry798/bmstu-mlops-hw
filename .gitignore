# Данные в git не попадают ни при каких обстоятельствах.
# Версионирует их DVC: в git уезжают только .dvc/dvc.lock с хэшами,
# а содержимое — в remote. Один раз закоммиченный JSONL останется
# в истории навсегда и будет клонироваться вместе с репозиторием.
data/
/data

# Артефакты окружения и инструментов
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Мусор редакторов и ОС
.DS_Store
*.bak
*.orig
*~
.idea/
.vscode/

# Локальный кеш и remote DVC, если он внутри дерева
/dvc-storage/
hw3-dvc-storage/